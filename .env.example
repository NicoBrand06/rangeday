# Copy to .env.local to override locally. On Vercel, set these in Settings → Environment Variables.

# Hosted database (leave unset locally to use the file rangeday.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# true = public demo (demo logins, synthetic data, weekly reset, branding locked).
# Leave unset for a real club: nothing is ever wiped.
DEMO_MODE=

# Comma-separated emails that become staff when they sign up or log in.
STAFF_EMAILS=
